# ---- Application ----
APP_NAME="QUANTSIGNAL AI Backend"
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Comma-separated allowed origins. Set to your frontend URL in production.
# Use "*" only for development.
CORS_ORIGINS=*

# ---- Telegram ----
# Bot token from @BotFather. Required to validate Mini App initData server-side.
# NEVER expose this to the frontend. Keep it server-only and rotate immediately
# if it leaks.
TELEGRAM_BOT_TOKEN=
# Maximum age of initData in seconds (default 86400 = 24h).
TELEGRAM_INIT_DATA_MAX_AGE=86400

# ---- Bybit (public market data, no key required) ----
BYBIT_REST_BASE=https://api.bybit.com
BYBIT_WS_PUBLIC=wss://stream.bybit.com/v5/public/linear
BYBIT_CATEGORY=linear

# Default symbols when none provided in query.
MARKET_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,TONUSDT,XRPUSDT

# ---- AI assistant (optional) ----
# When unset, /api/ai/chat returns a deterministic structured mock.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
