# ---- Application ----
APP_NAME="QUANTSIGNAL AI Backend"
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Comma-separated allowed origins. Set to your frontend URL in production.
# Use "*" only for development.
CORS_ORIGINS=*

# ---- Telegram ----
# Bot token from @BotFather. Required to validate Mini App initData server-side.
# NEVER expose this to the frontend. Keep it server-only and rotate immediately
# if it leaks.
TELEGRAM_BOT_TOKEN=
# Maximum age of initData in seconds (default 86400 = 24h).
TELEGRAM_INIT_DATA_MAX_AGE=86400

# ---- Bybit (public market data, no key required) ----
BYBIT_REST_BASE=https://api.bybit.com
BYBIT_WS_PUBLIC=wss://stream.bybit.com/v5/public/linear
BYBIT_CATEGORY=linear

# Default symbols when none provided in query.
MARKET_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,TONUSDT,XRPUSDT

# ---- AI assistant (server-side LLM proxy) ----
# When unset (and AI_ALLOW_NO_KEY is not enabled), /api/ai/chat returns
# HTTP 503 {"error":"ai_not_configured"}. The frontend then shows a
# configuration error — never a fake demo reply.
#
# Preferred names (also read by the Vercel serverless function in /api/ai):
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=25000
# AI_TEMPERATURE=0.2
#
# Public, no-auth OpenAI-compatible provider example (Pollinations).
# When AI_ALLOW_NO_KEY=true the server treats AI as configured even
# without AI_API_KEY and does NOT send an Authorization header upstream.
# Equivalent: AI_AUTH_MODE=none.
# AI_BASE_URL=https://gen.pollinations.ai/v1
# AI_MODEL=openai
# AI_ALLOW_NO_KEY=true
# AI_AUTH_MODE=none
#
# Recommended for production / private providers: leave AI_ALLOW_NO_KEY
# unset and provide a real AI_API_KEY.
#
# Legacy names still accepted as fallbacks:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
